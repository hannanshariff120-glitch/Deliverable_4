from math import integer


def main():
    user_input = input ("Enter an integer between 1 and 10:")


    try:
        number = integer(user_input)
        if 1 <= number <= 10:
            for i in range (1, number + 1):
                print(i)
        else:
            print("Error: The number must be between 1 and 10")
    except ValueError:
        print("Error: Please enter a valid number shawty")
if __name__ == "__main__":
    main()